  {
   "id": "u2",
   "title": "Al bar",
   "hu": "Kávézóban",
   "grammar": [
    {
     "h": "Nemek",
     "p": "A főnevek hím- vagy nőneműek. Általában: -o végű hímnem (il caffè kivétel), -a végű nőnem. Az -e végűeknél meg kell tanulni, ezért mindig névelővel tanuld a szót."
    },
    {
     "h": "Határozott névelő (a, az)",
     "p": "il – hímnem, mássalhangzó előtt (il latte) · lo – hímnem, s+mássalhangzó vagy z előtt (lo zucchero) · la – nőnem (la tazza) · l' – magánhangzó előtt (l'acqua)."
    },
    {
     "h": "Határozatlan névelő (egy)",
     "p": "un caffè · uno zucchero · una tazza · un'acqua. Rendelni így a legegyszerűbb: Vorrei + un/una + ital."
    }
   ],
