{
  "name": "onismeret",
  "private": true,
  "description": "Önismereti térképek — build és automatikus ellenőrzés",
  "scripts": {
    "build": "python3 tools/build.py",
    "schema": "node tools/schema.js",
    "test": "node tests/run.js",
    "test:tarsas": "node tests/tarsas.test.cjs && npm run test:activity18",
    "test:activity18": "npm --prefix tarsas/activity18 test",
    "test:tarsas:browser": "node tests/tarsas-browser.cjs",
    "test:paros": "node --test paros/tests/content.test.cjs && node paros/tests/run.cjs && node paros/tests/a11y.cjs",
    "test:hp": "node --test tarsas/harry-potter/tests/*.test.cjs"
  },
  "devDependencies": {
    "axe-core": "4.10.2",
    "playwright": "1.63.0"
  }
}
